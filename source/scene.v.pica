; Scene vertex shader: textures carry baked lighting, so no light maths here.
; outclr is a per-draw tint (white = untouched), used later for highlights.

.fvec projection[4], modelView[4], tint

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  ones myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex
	mov outclr, tint
	end
.end
